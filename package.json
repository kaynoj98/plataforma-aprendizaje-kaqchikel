{
  "name": "plataforma-kaqchikel",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web para el aprendizaje del idioma kaqchikel.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "e2e": "node e2e/run.cjs",
    "e2e:install": "node e2e/install.cjs",
    "e2e:report": "node e2e/report.cjs",
    "lint": "pnpm --filter @kaqchikel/web lint && node apps/web/node_modules/eslint/bin/eslint.js --config e2e/eslint.config.cjs e2e",
    "dev": "pnpm --parallel --filter @kaqchikel/web --filter @kaqchikel/api run dev",
    "dev:web": "pnpm --filter @kaqchikel/web run dev",
    "dev:api": "pnpm --filter @kaqchikel/api run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @kaqchikel/api run prisma:generate",
    "db:migrate": "pnpm --filter @kaqchikel/api run prisma:migrate",
    "db:seed": "pnpm --filter @kaqchikel/api run db:seed",
    "db:studio": "pnpm --filter @kaqchikel/api run prisma:studio",
    "services:up": "docker compose up -d postgres garage",
    "services:stop": "docker compose stop postgres garage",
    "services:logs": "docker compose logs -f postgres garage"
  }
}
