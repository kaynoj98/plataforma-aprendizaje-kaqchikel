generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  ADMIN
  USER
}

enum ProfileType {
  STUDENT
  TEACHER
  OTHER
}

enum AccountStatus {
  PENDING
  ACTIVE
  BLOCKED
  DISABLED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentBlockType {
  TEXT
  HEADING
  IMAGE
  AUDIO
  VIDEO
  DIALOGUE
  EXAMPLE
  NOTE
  VOCABULARY
  DOCUMENT
  QUIZ
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  PROCESSING
  AVAILABLE
  FAILED
  DELETED
}

// ======================================================
// USERS
// ======================================================

model User {
  id           String        @id @default(uuid()) @db.Uuid
  firstName    String        @map("first_name") @db.VarChar(100)
  lastName     String        @map("last_name") @db.VarChar(100)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         Role          @default(USER)
  profileType  ProfileType   @default(STUDENT) @map("profile_type")
  status       AccountStatus @default(PENDING)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  blockedAt       DateTime? @map("blocked_at") @db.Timestamptz(3)
  blockedReason   String?   @map("blocked_reason") @db.Text
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  auditLogs AuditLog[] @relation("AuditActor")

  createCourses Course[] @relation("CourseCreator")

  uploadedMedia MediaFile[] @relation("MediaUploader")

  @@index([role])
  @@index([profileType])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

// ======================================================
// AUTHENTICATION
// ======================================================

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ======================================================
// AUDIT
// ======================================================

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid

  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(100)
  entityId   String? @map("entity_id") @db.Uuid

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ======================================================
// COURSES
// ======================================================

model Course {
  id          String @id @default(uuid()) @db.Uuid
  title       String @db.VarChar(200)
  slug        String @unique @db.VarChar(220)
  description String @db.Text

  objectives String? @db.Text

  difficulty CourseDifficulty @default(BEGINNER)
  status     PublishStatus    @default(DRAFT)

  position Int @default(0)

  isPublicPreview Boolean @default(false) @map("is_public_preview")

  createdById String @map("created_by_id") @db.Uuid

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  levels CourseLevel[]

  @@index([status])
  @@index([difficulty])
  @@index([position])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("courses")
}

// ======================================================
// COURSE LEVELS
// ======================================================

model CourseLevel {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.Text

  position Int @default(0)

  status PublishStatus @default(DRAFT)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  units CourseUnit[]

  @@index([courseId])
  @@index([status])
  @@index([position])
  @@index([deletedAt])
  @@map("course_levels")
}

// ======================================================
// COURSE UNITS
// ======================================================

model CourseUnit {
  id      String @id @default(uuid()) @db.Uuid
  levelId String @map("level_id") @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.Text

  position Int @default(0)

  status PublishStatus @default(DRAFT)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  level CourseLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([levelId])
  @@index([status])
  @@index([position])
  @@index([deletedAt])
  @@map("course_units")
}

// ======================================================
// LESSONS
// ======================================================

model Lesson {
  id     String @id @default(uuid()) @db.Uuid
  unitId String @map("unit_id") @db.Uuid

  title String @db.VarChar(200)
  slug  String @db.VarChar(220)

  description String? @db.Text

  estimatedMinutes Int @default(10) @map("estimated_minutes")

  position Int @default(0)

  status PublishStatus @default(DRAFT)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit CourseUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  blocks LessonContentBlock[]

  vocabularyItems LessonVocabulary[]

  @@unique([unitId, slug])
  @@index([unitId])
  @@index([status])
  @@index([position])
  @@index([deletedAt])
  @@map("lessons")
}

// ======================================================
// LESSON CONTENT BLOCKS
// ======================================================

model LessonContentBlock {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid

  type ContentBlockType

  title   String? @db.VarChar(200)
  content Json

  position Int @default(0)

  isVisible Boolean @default(true) @map("is_visible")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([type])
  @@index([position])
  @@index([deletedAt])
  @@map("lesson_content_blocks")
}

// ======================================================
// MEDIA
// ======================================================

model MediaFile {
  id           String @id @default(uuid()) @db.Uuid
  uploadedById String @map("uploaded_by_id") @db.Uuid

  originalName String @map("original_name") @db.VarChar(255)
  objectKey    String @unique @map("object_key") @db.VarChar(500)
  bucket       String @db.VarChar(100)

  mediaType MediaType @map("media_type")
  mimeType  String    @map("mime_type") @db.VarChar(150)
  sizeBytes Int       @map("size_bytes")

  status MediaStatus @default(PROCESSING)

  metadata Json?

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy User @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  vocabularyPronunciations VocabularyItem[] @relation("VocabularyPronunciationMedia")
  vocabularyImages         VocabularyItem[] @relation("VocabularyImageMedia")

  @@index([uploadedById])
  @@index([mediaType])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("media_files")
}

// ======================================================
// VOCABULARY CATEGORIES
// ======================================================

model VocabularyCategory {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)

  slug String @unique @db.VarChar(180)

  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vocabularyItems VocabularyItem[]

  @@index([name])
  @@index([createdAt])
  @@map("vocabulary_categories")
}

// ======================================================
// KAQCHIKEL VARIANTS
// ======================================================

model VocabularyVariant {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)

  code String @unique @db.VarChar(50)

  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vocabularyItems VocabularyItem[]

  @@index([name])
  @@index([createdAt])
  @@map("vocabulary_variants")
}

// ======================================================
// VOCABULARY ITEMS
// ======================================================

model VocabularyItem {
  id String @id @default(uuid()) @db.Uuid

  term String @db.VarChar(200)

  translation String @db.VarChar(255)

  meaning String? @db.Text

  exampleKaqchikel String? @map("example_kaqchikel") @db.Text
  exampleSpanish   String? @map("example_spanish") @db.Text

  notes String? @db.Text

  categoryId String? @map("category_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid

  pronunciationMediaId String? @map("pronunciation_media_id") @db.Uuid
  imageMediaId         String? @map("image_media_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category VocabularyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variant VocabularyVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  pronunciationMedia MediaFile? @relation("VocabularyPronunciationMedia", fields: [pronunciationMediaId], references: [id], onDelete: SetNull)

  imageMedia MediaFile? @relation("VocabularyImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)

  lessonLinks LessonVocabulary[]

  @@index([term])
  @@index([translation])
  @@index([categoryId])
  @@index([variantId])
  @@index([pronunciationMediaId])
  @@index([imageMediaId])
  @@index([isActive])
  @@index([createdAt])
  @@map("vocabulary_items")
}

// ======================================================
// LESSON ↔ VOCABULARY
// ======================================================

model LessonVocabulary {
  id String @id @default(uuid()) @db.Uuid

  lessonId     String @map("lesson_id") @db.Uuid
  vocabularyId String @map("vocabulary_id") @db.Uuid

  position Int @default(0)

  isVisible Boolean @default(true) @map("is_visible")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  vocabulary VocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([lessonId, vocabularyId])
  @@index([lessonId])
  @@index([vocabularyId])
  @@index([position])
  @@index([isVisible])
  @@map("lesson_vocabulary")
}
